# DashboardX environment example.
# Copy to .env and fill in real values locally. Never commit .env.

# HTTP server (local development)
HOST=127.0.0.1
PORT=3030

# WebSocket access token: generate locally with 'openssl rand -hex 32'.
# Never commit the generated token. A missing or short token disables WebSocket.
DASHBOARDX_WS_TOKEN=

# Optional credentials (leave blank until configured securely)
USERNAME=
PASSWORD=
API_BINANCE_TOKEN=
API_TELEGRAM_TOKEN=

# Legacy paths: server currently expects the project inside $HOME/_data/code/
PROJECT_DIR=_data/code
DASHBOARDX_DIR=dashboardx
CLIENT_DIR=client
PUBLIC_DIR=public
CLIENT_HTML_TEST_NAME=__template.html
SERVER_DIR=server
DATABASE_DIR=db
STORAGE_DIR=storage
